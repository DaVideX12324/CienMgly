[node name="DomPietro" type="StaticBody2D" unique_id=1537298522]
editor_description = "Szablon domu (duplikować: PPM -> Duplikuj w Systemie plików).
Origin (0, 0): punkt sortowania całego domu = 15 px nad dolną krawędzią BaseCollision, x = środek drzwi. Korzeń bez Y Sort — dom sortuje się z postaciami w całości w tym punkcie; kafle w Tilesets (Y Sort) sortują się między sobą.
Warstwy (pixel_crawler_free.tres): Walls (+ WallsDetail, WallsDetail2), Roof (+ Roof2, Roof3), DoorFrame, Props, Chimney (z 1, + ChimneyRoof), Shadow (z 1). Puste warstwy można usunąć.
BaseCollision: obrys podstawy ścian (dolna krawędź 15 px pod originem). DoorArea: obszar przy drzwiach (okrąg), DoorSpot: punkt tuż przed drzwiami (2 px pod podstawą).
Dom z wnękami (różne podstawy ścian): tools/segment_building.gd (lift=15)."
y_sort_enabled = true
collision_layer = 32
collision_mask = 0

