[sub_resource type="Resource" id="Quest_brann_tempering"]
script = ExtResource("quest_svc")
quest_id = "brann_tempering"
title = "Hartowanie"
title_key = "quest.brann_tempering.title"
goal = 0
goal_count = 10
offer_lines = PackedStringArray("Hartowanie… to słowo coś mi mówi, ale nic więcej. Mgła wyżarła mi z głowy całe rzemiosło.", "Ty masz głowę na karku. Odpowiedz poprawnie na {count} pytań — może przy tobie i mnie coś wróci.")
offer_key = "quest.brann_tempering.offer"
progress_lines = PackedStringArray("Jeszcze {left}. Czuję, że już blisko…")
progress_key = "quest.brann_tempering.progress"
done_lines = PackedStringArray("Jest! Olej, ogień, woda — tak się hartuje żelazo! Zajrzyj do mojego towaru.")
done_key = "quest.brann_tempering.done"
required_flag = "boss:cave_relic"

[sub_resource type="Resource" id="Quest_brann_runes"]
script = ExtResource("quest_svc")
quest_id = "brann_runes"
title = "Runy na stali"
title_key = "quest.brann_runes.title"
goal = 0
goal_count = 20
offer_lines = PackedStringArray("Ojciec rył runy na rękojeściach. Pamiętam kształty, nie pamiętam znaczeń.", "Pomóż mi jeszcze raz — {count} poprawnych odpowiedzi i spróbuję je odczytać.")
offer_key = "quest.brann_runes.offer"
progress_lines = PackedStringArray("Jeszcze {left}. Runy już prawie mówią.")
progress_key = "quest.brann_runes.progress"
done_lines = PackedStringArray("Rozumiem je! Mam dla ciebie lepszą broń — wykutą jak dawniej.")
done_key = "quest.brann_runes.done"
after_lines = PackedStringArray("Runy trzymają się stali. Ja też już się trzymam.")
after_key = "quest.brann_runes.after"
required_flag = "quest:brann_tempering"

[sub_resource type="Resource" id="Resource_6ktd1"]
script = ExtResource("4_05lib")
stock = Array[ExtResource("5_fejpd")]([SubResource("Resource_0nkv3"), SubResource("Resource_pr84e"), SubResource("Resource_jr2eo"), SubResource("Resource_akqrx"), SubResource("Resource_8gqc1"), SubResource("Resource_ogi4h"), SubResource("Resource_ok8pr"), SubResource("Resource_r7bor"), SubResource("Entry_tempered_sword"), SubResource("Entry_tempered_dagger"), SubResource("Entry_oak_staff"), SubResource("Entry_iron_mace"), SubResource("Entry_guardsman_sword"), SubResource("Entry_stiletto"), SubResource("Entry_runed_staff"), SubResource("Entry_flanged_mace"), SubResource("Resource_hts7l")])
