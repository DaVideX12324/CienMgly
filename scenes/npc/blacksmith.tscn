[sub_resource type="Resource" id="Quest_brann_ore"]
script = ExtResource("quest_svc")
quest_id = "brann_ore"
title = "Lepsza ruda"
title_key = "quest.brann_ore.title"
goal = 2
goal_count = 5
goal_target = "iron_ore"
offer_lines = PackedStringArray("Z żelaza, które mi zostało, lepszego ostrza nie wykuję — same żużle i rdza. Kopalnie stoją, odkąd przyszła Mgła.", "Stwory z jaskiń i kanałów wloką ze sobą bryły rudy. Przynieś mi {count}, a wykuję hartowane ostrza.")
offer_key = "quest.brann_ore.offer"
progress_lines = PackedStringArray("Brakuje jeszcze {left} brył rudy. Szukaj u stworów w jaskiniach i kanałach.")
progress_key = "quest.brann_ore.progress"
done_lines = PackedStringArray("Porządna ruda! Wytopię ją jeszcze dziś. Zajrzyj do mojego towaru — hartowane ostrza czekają.")
done_key = "quest.brann_ore.done"

[sub_resource type="Resource" id="Quest_brann_steel"]
script = ExtResource("quest_svc")
quest_id = "brann_steel"
title = "Węgiel i stal"
title_key = "quest.brann_steel.title"
goal = 4
goal_count = 300
offer_lines = PackedStringArray("Ruda to połowa sukcesu. Na lepszą broń potrzebuję węgla drzewnego i kilku sztabek dobrej stali.", "Handlarz z bramy sprzeda mi je za {count} D. Zrzucisz się? Wykuję z nich broń, jakiej to miasto dawno nie widziało.")
offer_key = "quest.brann_steel.offer"
progress_lines = PackedStringArray("Handlarz chce {count} D. Wróć, gdy uzbierasz.")
progress_key = "quest.brann_steel.progress"
done_lines = PackedStringArray("Dziękuję! Za węgiel i stal wykuję ci najlepsze, co umiem. Rzuć okiem na towar.")
done_key = "quest.brann_steel.done"
after_lines = PackedStringArray("Dobry węgiel, dobra stal — i od razu ręka pewniejsza.")
after_key = "quest.brann_steel.after"
required_flag = "quest:brann_ore"

[sub_resource type="Resource" id="Resource_6ktd1"]
script = ExtResource("4_05lib")
stock = Array[ExtResource("5_fejpd")]([SubResource("Resource_0nkv3"), SubResource("Resource_pr84e"), SubResource("Resource_jr2eo"), SubResource("Resource_akqrx"), SubResource("Resource_8gqc1"), SubResource("Resource_ogi4h"), SubResource("Resource_ok8pr"), SubResource("Resource_r7bor"), SubResource("Entry_tempered_sword"), SubResource("Entry_tempered_dagger"), SubResource("Entry_oak_staff"), SubResource("Entry_iron_mace"), SubResource("Entry_guardsman_sword"), SubResource("Entry_stiletto"), SubResource("Entry_runed_staff"), SubResource("Entry_flanged_mace"), SubResource("Resource_hts7l")])
intro_lines = PackedStringArray()
label = "Handel"
label_key = "npc.service.shop"

[sub_resource type="Resource" id="Resource_upgr1"]
script = ExtResource("15_upgr")
intro_lines = PackedStringArray()
label = "Ulepsz broń"
label_key = "npc.service.upgrade"

[sub_resource type="Resource" id="Resource_recl1"]
script = ExtResource("16_recl")
lines = PackedStringArray("Czekaj… coś mi wraca. Wiem już, jak hartować stal! Zajrzyj do mnie — mam dla ciebie lepsze ostrza.")
lines_key = "npc.blacksmith.recall"
set_flag = "recall:blacksmith:sewer"
auto_once = true
required_flag = "boss:sewer"

[node name="Blacksmith" instance=ExtResource("0_base")]
npc_name = "Brann"
npc_name_key = "npc.blacksmith.name"
sprite_frames = ExtResource("2_th7q5")
sprite_offset = Vector2(0, -30)
greeting = PackedStringArray("Ostrza, topory, włócznie. Lepszej stali nie pamiętam… jeszcze.")
greeting_key = "npc.blacksmith.greeting"
services = Array[ExtResource("3_vxe2y")]([SubResource("Resource_6ktd1"), SubResource("Resource_upgr1"), SubResource("Resource_recl1"), SubResource("Quest_brann_ore"), SubResource("Quest_brann_steel")])
