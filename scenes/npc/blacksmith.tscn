[sub_resource type="Resource" id="Resource_recl1"]
script = ExtResource("16_recl")
lines = PackedStringArray("Czekaj… coś mi wraca. Wiem już, jak hartować stal! Zajrzyj do mnie — mam dla ciebie lepsze ostrza.")
lines_key = "npc.blacksmith.recall"
set_flag = "recall:blacksmith:sewer"
auto_once = true
required_flag = "boss:sewer"

[node name="Blacksmith" instance=ExtResource("0_base")]
npc_name = "Brann"
npc_name_key = "npc.blacksmith.name"
sprite_frames = ExtResource("2_th7q5")
sprite_offset = Vector2(0, -30)
greeting = PackedStringArray("Ostrza, topory, włócznie. Lepszej stali nie pamiętam… jeszcze.")
greeting_key = "npc.blacksmith.greeting"
services = Array[ExtResource("3_vxe2y")]([SubResource("Resource_6ktd1"), SubResource("Resource_upgr1"), SubResource("Resource_recl1"), SubResource("Quest_brann_tempering"), SubResource("Quest_brann_runes")])
