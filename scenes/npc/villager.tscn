[sub_resource type="Resource" id="Resource_0fws8"]
script = ExtResource("4_mshdv")
lines = PackedStringArray("Czasem wydaje mi się, że pamiętam śpiew ptaków… ale Mgła zabiera wszystko.", "Uważaj na siebie. Słyszałam, że pod miastem ktoś widział światło w kanałach.")
lines_key = "npc.villager.talk"
repeat_lines = PackedStringArray()
label = "Rozmowa"
label_key = "npc.service.talk"

[sub_resource type="Resource" id="Resource_rats"]
script = ExtResource("5_quest")
quest_id = "lina_rats"
title = "Szczury w kanałach"
title_key = "quest.lina_rats.title"
goal_count = 5
goal_target = "rat_*"
goal_text = "Pokonaj szczury w kanałach"
goal_key = "quest.lina_rats.goal"
reward_gold = 150
reward_items = Dictionary[String, int]({
"potion": 2
})
offer_lines = PackedStringArray("Z kanałów pod miastem wyłażą szczury. Coraz większe i coraz śmielsze.", "Przegoń {count} z nich, a odwdzięczę się — {reward}.")
offer_key = "quest.lina_rats.offer"
progress_lines = PackedStringArray("Jeszcze {left}. Wejście do kanałów jest na północy miasta.")
progress_key = "quest.lina_rats.progress"
done_lines = PackedStringArray("Naprawdę to zrobiłeś? Dziękuję! Proszę, weź to.")
done_key = "quest.lina_rats.done"
after_lines = PackedStringArray("Od kiedy przegoniłeś szczury, śpię spokojniej.")
after_key = "quest.lina_rats.after"

[node name="Villager" instance=ExtResource("0_base")]
