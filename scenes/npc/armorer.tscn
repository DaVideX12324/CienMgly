[sub_resource type="Resource" id="Quest_kastor_studs"]
script = ExtResource("quest_svc")
quest_id = "kastor_studs"
title = "Ćwieki z pola walki"
title_key = "quest.kastor_studs.title"
goal = 1
goal_count = 8
offer_lines = PackedStringArray("Kiedyś nabijałem kaftany ćwiekami — palce to pamiętają, głowa nie.", "Pokonaj {count} wrogów. Jak zobaczę, czym walczą stwory spod Mgły, przypomnę sobie, czym się przed nimi bronić.")
offer_key = "quest.kastor_studs.offer"
progress_lines = PackedStringArray("Jeszcze {left}. Opowiadaj, jak walczą.")
progress_key = "quest.kastor_studs.progress"
done_lines = PackedStringArray("Tak! Ćwieki w rzędach, gęsto przy sercu. Mam dla ciebie lepszy pancerz.")
done_key = "quest.kastor_studs.done"
required_flag = "boss:cave_relic"

[sub_resource type="Resource" id="Quest_kastor_scales"]
script = ExtResource("quest_svc")
quest_id = "kastor_scales"
title = "Łuski"
title_key = "quest.kastor_scales.title"
goal = 1
goal_count = 15
offer_lines = PackedStringArray("Łuski… zachodzące na siebie łuski. Widzę je we śnie, ale nie wiem, jak je szyć.", "Pokonaj jeszcze {count} wrogów, a ja będę patrzył na twój pancerz po każdej walce.")
offer_key = "quest.kastor_scales.offer"
progress_lines = PackedStringArray("Jeszcze {left}. Prawie widzę wzór.")
progress_key = "quest.kastor_scales.progress"
done_lines = PackedStringArray("Mam wzór! Zbroja łuskowa, czepiec i tarcza — gotowe dla ciebie.")
done_key = "quest.kastor_scales.done"
after_lines = PackedStringArray("Łuska do łuski. Tak się trzyma i zbroja, i pamięć.")
after_key = "quest.kastor_scales.after"
required_flag = "quest:kastor_studs"

