[sub_resource type="Resource" id="Quest_kastor_hides"]
script = ExtResource("quest_svc")
quest_id = "kastor_hides"
title = "Surowe skóry"
title_key = "quest.kastor_hides.title"
goal = 2
goal_count = 5
goal_target = "raw_hide"
offer_lines = PackedStringArray("Na porządny kaftan potrzebuję skór, a zapasy dawno się skończyły.", "Stwory w kanałach mają grube skóry. Przynieś mi {count}, a uszyję ci ćwiekowany pancerz.")
offer_key = "quest.kastor_hides.offer"
progress_lines = PackedStringArray("Jeszcze {left} skór. Szukaj ich w kanałach.")
progress_key = "quest.kastor_hides.progress"
done_lines = PackedStringArray("Dobre skóry! Wyprawię je i nabiję ćwiekami. Zajrzyj do mojego towaru.")
done_key = "quest.kastor_hides.done"
required_flag = "boss:cave"

[sub_resource type="Resource" id="Quest_kastor_scales"]
script = ExtResource("quest_svc")
quest_id = "kastor_scales"
title = "Żelazne łuski"
title_key = "quest.kastor_scales.title"
goal = 2
goal_count = 8
goal_target = "iron_ore"
offer_lines = PackedStringArray("Zbroja łuskowa to setki żelaznych łusek, a z rdzy ich nie wyklepię.", "Przynieś mi {count} brył rudy żelaza. Brann pomoże ją wytopić.")
offer_key = "quest.kastor_scales.offer"
progress_lines = PackedStringArray("Brakuje jeszcze {left} brył rudy.")
progress_key = "quest.kastor_scales.progress"
done_lines = PackedStringArray("Tyle żelaza! Starczy na zbroję łuskową, czepiec i tarczę. Są twoje — za uczciwą cenę.")
done_key = "quest.kastor_scales.done"
after_lines = PackedStringArray("Łuska do łuski — tak się trzyma dobra zbroja.")
after_key = "quest.kastor_scales.after"
required_flag = "quest:kastor_hides"

